11. LC 2523  closest prime numbers in range
code:
class Solution {

    public int[] closestPrimes(int left, int right) {

        int prev = -1;
        int minDiff = Integer.MAX_VALUE;

        int[] ans = {-1, -1};

        for (int num = left; num <= right; num++) {

            if (isPrime(num)) {

                if (prev != -1) {

                    int diff = num - prev;

                    if (diff < minDiff) {
                        minDiff = diff;
                        ans[0] = prev;
                        ans[1] = num;
                    }

                    if (minDiff <= 2) {
                        return ans;
                    }
                }

                prev = num;
            }
        }

        return ans;
    }

    private boolean isPrime(int n) {

        if (n < 2) {
            return false;
        }

        for (int i = 2; i * i <= n; i++) {

            if (n % i == 0) {
                return false;
            }
        }

        return true;
    }
}
