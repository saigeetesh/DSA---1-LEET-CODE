class Solution {
    public int countPrimes(int n) {
        if (n <= 2) {
            return 0;
        }

        // isPrime[i] will store whether i is prime or not
        boolean[] isPrime = new boolean[n];
        // Initialize all entries as true
        for (int i = 2; i < n; i++) {
            isPrime[i] = true;
        }

        // Apply Sieve of Eratosthenes
        for (int i = 2; i * i < n; i++) {
            if (isPrime[i]) {
                // Mark multiples of i starting from i * i as false
                for (int j = i * i; j < n; j += i) {
                    isPrime[j] = false;
                }
            }
        }

        // Count remaining primes
        int count = 0;
        for (int i = 2; i < n; i++) {
            if (isPrime[i]) {
                count++;
            }
        }

        return count;
    }
}
