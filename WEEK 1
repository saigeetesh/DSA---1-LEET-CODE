class Solution {
    public int mySqrt(int x) {
        if (x < 2) {
            return x;
        }

        int left = 1;
        int right = x / 2;
        int ans = 0;

        while (left <= right) {
            int mid = left + (right - left) / 2;

            // Use long to prevent integer overflow when calculating mid * mid
            if ((long) mid * mid <= x) {
                ans = mid; // Record mid as potential answer
                left = mid + 1; // Try to find a larger value
            } else {
                right = mid - 1; // mid * mid is too large
            }
        }

        return ans;
    }
}
