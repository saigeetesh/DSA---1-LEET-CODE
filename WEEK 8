class Solution {
    public int countNegatives(int[][] grid) {
        int m = grid.length;
        int n = grid[0].length;
        int row = 0;
        int col = n - 1;
        int count = 0;

        while (row < m && col >= 0) {
            if (grid[row][col] < 0) {
                // Everything below in this column is also negative
                count += (m - row);
                col--;
            } else {
                // Non-negative here; move down to find negatives
                row++;
            }
        }

        return count;
    }
}
