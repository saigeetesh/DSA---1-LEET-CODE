class Solution {
    public int singleNonDuplicate(int[] nums) {
        int left = 0;
        int right = nums.length - 1;

        while (left < right) {
            int mid = left + (right - left) / 2;

            // Ensure mid points to the first element of a pair (even index)
            if (mid % 2 == 1) {
                mid--;
            }

            if (nums[mid] == nums[mid + 1]) {
                // Pair is aligned on the left; single element is strictly to the right
                left = mid + 2;
            } else {
                // Pairing is broken here or earlier; single element is at mid or to the left
                right = mid;
            }
        }

        return nums[left];
    }
}
