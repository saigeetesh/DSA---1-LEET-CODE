class Solution {
    public int kthSmallest(int[][] matrix, int k) {
        int n = matrix.length;
        int left = matrix[0][0];
        int right = matrix[n - 1][n - 1];

        while (left < right) {
            int mid = left + (right - left) / 2;
            int count = countLessOrEqual(matrix, mid);

            if (count < k) {
                // Fewer than k elements are <= mid; the kth smallest is strictly larger
                left = mid + 1;
            } else {
                // At least k elements are <= mid; answer is mid or smaller
                right = mid;
            }
        }

        return left;
    }

    private int countLessOrEqual(int[][] matrix, int target) {
        int n = matrix.length;
        int row = n - 1;
        int col = 0;
        int count = 0;

        // Staircase walk starting at bottom-left: up decreases row, right increases col
        while (row >= 0 && col < n) {
            if (matrix[row][col] <= target) {
                // Every element in this column from row 0 down to row is <= target
                count += row + 1;
                col++;
            } else {
                row--;
            }
        }

        return count;
    }
}
