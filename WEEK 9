class Solution {
    public int smallestDivisor(int[] nums, int threshold) {
        int left = 1;
        int right = 0;

        for (int num : nums) {
            right = Math.max(right, num);
        }

        while (left < right) {
            int mid = left + (right - left) / 2;

            if (divisionSum(nums, mid) <= threshold) {
                // Divisor mid works; search for a smaller valid divisor
                right = mid;
            } else {
                // Sum is too high; increase divisor to reduce quotients
                left = mid + 1;
            }
        }

        return left;
    }

    private int divisionSum(int[] nums, int divisor) {
        int sum = 0;

        for (int num : nums) {
            sum += (num + divisor - 1) / divisor;
        }

        return sum;
    }
}
4. LC 1482 minimum number of days to make m boquets
code:
class Solution {
    public int minDays(int[] bloomDay, int m, int k) {
        int n = bloomDay.length;
        // Each bouquet takes k flowers; prevent m * k int overflow
        if ((long) m * k > n) {
            return -1;
        }

        int left = Integer.MAX_VALUE;
        int right = Integer.MIN_VALUE;

        for (int day : bloomDay) {
            left = Math.min(left, day);
            right = Math.max(right, day);
        }

        while (left < right) {
            int mid = left + (right - left) / 2;

            if (canMakeBouquets(bloomDay, m, k, mid)) {
                // Can make m bouquets by day mid; look for an earlier day
                right = mid;
            } else {
                // Not enough bouquets by day mid; need to wait longer
                left = mid + 1;
            }
        }

        return left;
    }

    private boolean canMakeBouquets(int[] bloomDay, int m, int k, int day) {
        int bouquets = 0;
        int adjacentBloomed = 0;

        for (int bDay : bloomDay) {
            if (bDay <= day) {
                adjacentBloomed++;
                if (adjacentBloomed == k) {
                    bouquets++;
                    adjacentBloomed = 0;
                    if (bouquets >= m) {
                        return true;
                    }
                }
            } else {
                // Unbloomed flower breaks adjacency
                adjacentBloomed = 0;
            }
        }

        return bouquets >= m;
    }
}
