class Solution {
    public int splitArray(int[] nums, int k) {
        long left = 0;
        long right = 0;

        for (int num : nums) {
            left = Math.max(left, num);
            right += num;
        }

        while (left < right) {
            long mid = left + (right - left) / 2;

            if (canSplit(nums, k, mid)) {
                // Largest sum mid is achievable; try to minimize it further
                right = mid;
            } else {
                // Largest sum mid is too tight; increase the cap
                left = mid + 1;
            }
        }

        return (int) left;
    }

    private boolean canSplit(int[] nums, int k, long maxAllowedSum) {
        int subarraysUsed = 1;
        long currentSum = 0;

        for (int num : nums) {
            if (currentSum + num > maxAllowedSum) {
                subarraysUsed++;
                currentSum = num;
                if (subarraysUsed > k) {
                    return false;
                }
            } else {
                currentSum += num;
            }
        }

        return true;
    }
}
