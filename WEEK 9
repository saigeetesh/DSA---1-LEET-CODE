class Solution {
    public int maximumCandies(int[] candies, long k) {
        int maxPile = 0;
        for (int pile : candies) {
            maxPile = Math.max(maxPile, pile);
        }

        int left = 0;
        int right = maxPile;

        while (left < right) {
            // Bias mid upward so two-element ranges [a, a+1] test a+1 first
            int mid = left + (right - left + 1) / 2;

            if (canAllocate(candies, k, mid)) {
                // Giving mid candies per child works; try for more
                left = mid;
            } else {
                // Not enough sub-piles of size mid; reduce candies per child
                right = mid - 1;
            }
        }

        return left;
    }

    private boolean canAllocate(int[] candies, long k, int perChild) {
        if (perChild == 0) {
            return true;
        }

        long childrenServed = 0L;
        for (int pile : candies) {
            childrenServed += pile / perChild;
            if (childrenServed >= k) {
                return true;
            }
        }

        return false;
    }
}
