class Solution {
    public long minimumTime(int[] time, int totalTrips) {
        int minBusTime = Integer.MAX_VALUE;
        for (int t : time) {
            minBusTime = Math.min(minBusTime, t);
        }

        long left = 1L;
        long right = (long) minBusTime * totalTrips;

        while (left < right) {
            long mid = left + (right - left) / 2;

            if (canComplete(time, totalTrips, mid)) {
                // Enough trips completed by time mid; try an earlier time
                right = mid;
            } else {
                // Not enough trips by time mid; need more time
                left = mid + 1;
            }
        }

        return left;
    }

    private boolean canComplete(int[] time, int totalTrips, long givenTime) {
        long tripsCompleted = 0L;

        for (int t : time) {
            tripsCompleted += givenTime / t;
            if (tripsCompleted >= totalTrips) {
                return true;
            }
        }

        return false;
    }
}
