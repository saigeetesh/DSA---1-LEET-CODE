class Solution {
    public int findKthNumber(int m, int n, int k) {
        int left = 1;
        int right = m * n;

        while (left < right) {
            int mid = left + (right - left) / 2;
            int count = countLessOrEqual(m, n, mid);

            if (count < k) {
                // Fewer than k numbers are <= mid; kth smallest is strictly larger
                left = mid + 1;
            } else {
                // At least k numbers are <= mid; answer is mid or smaller
                right = mid;
            }
        }

        return left;
    }

    private int countLessOrEqual(int m, int n, int target) {
        int count = 0;

        // Row i (1-indexed) contains multiples i * 1, i * 2, ..., i * n
        for (int i = 1; i <= m; i++) {
            count += Math.min(target / i, n);
        }

        return count;
    }
}
