class Solution {
    public int minimizedMaximum(int n, int[] quantities) {
        int left = 1;
        int right = 0;

        for (int q : quantities) {
            right = Math.max(right, q);
        }

        while (left < right) {
            int mid = left + (right - left) / 2;

            if (canDistribute(n, quantities, mid)) {
                // Maximum load mid works; try to minimize it further
                right = mid;
            } else {
                // Need more than n stores at cap mid; increase the cap
                left = mid + 1;
            }
        }

        return left;
    }

    private boolean canDistribute(int n, int[] quantities, int maxPerStore) {
        long storesNeeded = 0;

        for (int q : quantities) {
            storesNeeded += (q + maxPerStore - 1L) / maxPerStore;
            if (storesNeeded > n) {
                return false;
            }
        }

        return storesNeeded <= n;
    }
}
