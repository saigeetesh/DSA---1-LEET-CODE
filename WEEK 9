class Solution {
    public long maxRunTime(int n, int[] batteries) {
        long totalEnergy = 0L;
        for (int b : batteries) {
            totalEnergy += b;
        }

        long left = 0L;
        long right = totalEnergy / n;

        while (left < right) {
            // Bias mid upward so two-element ranges [a, a+1] test a+1 first
            long mid = left + (right - left + 1) / 2;

            if (canRunFor(n, batteries, mid)) {
                // Can run all n computers for mid minutes; try for more
                left = mid;
            } else {
                // Not enough usable energy to run for mid minutes; try less
                right = mid - 1;
            }
        }

        return left;
    }

    private boolean canRunFor(int n, int[] batteries, long targetMinutes) {
        long requiredEnergy = (long) n * targetMinutes;
        long usableEnergy = 0L;

        // A single battery can run at most one computer at any given moment,
        // so at most targetMinutes of its capacity can contribute to a targetMinutes run.
        for (int b : batteries) {
            usableEnergy += Math.min((long) b, targetMinutes);
            if (usableEnergy >= requiredEnergy) {
                return true;
            }
        }

        return false;
    }
}
