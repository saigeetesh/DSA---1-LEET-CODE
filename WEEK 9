class Solution {
    public int minimumSize(int[] nums, int maxOperations) {
        int left = 1;
        int right = 0;

        for (int balls : nums) {
            right = Math.max(right, balls);
        }

        while (left < right) {
            int mid = left + (right - left) / 2;

            if (canAchievePenalty(nums, maxOperations, mid)) {
                // Penalty mid is achievable; try to lower the max bag size
                right = mid;
            } else {
                // Too many splits needed at penalty mid; allow larger bags
                left = mid + 1;
            }
        }

        return left;
    }

    private boolean canAchievePenalty(int[] nums, int maxOperations, int maxBagSize) {
        long operationsNeeded = 0;

        for (int balls : nums) {
            if (balls > maxBagSize) {
                // Split into ceil(balls / maxBagSize) bags -> (balls - 1) / maxBagSize splits
                operationsNeeded += (balls - 1) / maxBagSize;
                if (operationsNeeded > maxOperations) {
                    return false;
                }
            }
        }

        return operationsNeeded <= maxOperations;
    }
}
