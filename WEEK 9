class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int left = 1;
        int right = 0;

        for (int pile : piles) {
            right = Math.max(right, pile);
        }

        while (left < right) {
            int mid = left + (right - left) / 2;

            if (canFinish(piles, h, mid)) {
                // Speed mid works; try to eat even slower
                right = mid;
            } else {
                // Speed mid is too slow; need a faster speed
                left = mid + 1;
            }
        }

        return left;
    }

    private boolean canFinish(int[] piles, int h, int speed) {
        long hoursNeeded = 0;

        for (int pile : piles) {
            hoursNeeded += (pile + speed - 1L) / speed;
            if (hoursNeeded > h) {
                return false;
            }
        }

        return hoursNeeded <= h;
    }
}
