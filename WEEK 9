class Solution {
    private static final int MAX_SPEED = 10_000_000;

    public int minSpeedOnTime(int[] dist, double hour) {
        int n = dist.length;
        // Each of the first (n - 1) trains takes at least 1 full hour after waiting
        if (hour <= n - 1) {
            return -1;
        }

        int left = 1;
        int right = MAX_SPEED;
        int ans = -1;

        while (left <= right) {
            int mid = left + (right - left) / 2;

            if (canArriveOnTime(dist, hour, mid)) {
                // Speed mid works; try a slower speed
                ans = mid;
                right = mid - 1;
            } else {
                // Too slow to make hour; try a faster speed
                left = mid + 1;
            }
        }

        return ans;
    }

    private boolean canArriveOnTime(int[] dist, double hour, int speed) {
        double totalTime = 0.0;
        int n = dist.length;

        // Trains 0 .. n-2 must depart at integer hours, so round up ride time
        for (int i = 0; i < n - 1; i++) {
            totalTime += Math.ceil((double) dist[i] / speed);
        }

        // Last train (n - 1) has no next train to wait for
        totalTime += (double) dist[n - 1] / speed;

        return totalTime <= hour;
    }
}
