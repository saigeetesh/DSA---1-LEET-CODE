class Solution {
    public int divide(int dividend, int divisor) {
        // Overflow case: -2^31 / -1 = 2^31, which exceeds Integer.MAX_VALUE (2^31 - 1)
        if (dividend == Integer.MIN_VALUE && divisor == -1) {
            return Integer.MAX_VALUE;
        }
        
        // Determine if the final quotient should be negative
        boolean isNegative = (dividend < 0) ^ (divisor < 0);
        
        // Convert both numbers to negative to avoid overflow when handling Integer.MIN_VALUE (-2^31)
        int a = dividend > 0 ? -dividend : dividend;
        int b = divisor > 0 ? -divisor : divisor;
        
        int quotient = 0;
        
        // Subtract the largest doubled divisor from the dividend repeatedly
        while (a <= b) {
            int value = b;
            int multiple = 1;
            
            // Check (value >= Integer.MIN_VALUE >> 1) before doubling to prevent underflow
            while (value >= -1073741824 && a <= value + value) {
                value += value;
                multiple += multiple;
            }
            
            a -= value;
            quotient += multiple;
        }
        
        return isNegative ? -quotient : quotient;
    }
}
