class Solution {
    public int hammingDistance(int x, int y) {
        int xor = x ^ y;
        int distance = 0;
        
        while (xor != 0) {
            xor &= (xor - 1); // Clears the rightmost set bit
            distance++;
        }
        
        return distance;
    }
}
