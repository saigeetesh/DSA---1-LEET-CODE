class Solution {
    public double myPow(double x, int n) {
        long power = Math.abs((long) n);
        double result = 1.0;
        
        while (power > 0) {
            if ((power & 1) == 1) {
                result *= x;
            }
            x *= x;
            power >>= 1;
        }
        
        // Divide by 1.0 at the end instead of the beginning to preserve precision
        return n < 0 ? 1.0 / result : result;
    }
}
