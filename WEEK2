class Solution {
    public int[] countBits(int n) {
        int[] ans = new int[n + 1];
        
        for (int i = 1; i <= n; i++) {
            // i >> 1 removes the last bit; (i & 1) checks if the removed bit was 1
            ans[i] = ans[i >> 1] + (i & 1);
        }
        
        return ans;
    }
}
