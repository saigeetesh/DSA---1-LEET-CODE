class Solution {
    public int countDigitOne(int n) {
        long count = 0;
        
        // Use a long for place value (1, 10, 100, ...) to prevent integer overflow when n is up to 10^9
        for (long i = 1; i <= n; i *= 10) {
            long divider = i * 10;
            
            // Complete cycles of 10^k contribute (n / (i * 10)) * i ones
            count += (n / divider) * i;
            
            // Partial cycle remainder contributes between 0 and i ones
            long remainder = n % divider;
            count += Math.min(Math.max(remainder - i + 1, 0L), i);
        }
        
        return (int) count;
    }
}
