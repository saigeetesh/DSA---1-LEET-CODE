class Solution {
    public int integerReplacement(int n) {
        long num = n;
        int steps = 0;

        while (num != 1) {
            if ((num & 1) == 0) {
                // Even: divide by 2
                num >>= 1;
            } else if (num == 3 || (num & 3) == 1) {
                // Odd ending in ...01 (or special case 3): subtract 1
                num--;
            } else {
                // Odd ending in ...11 (and != 3): add 1 to create trailing zeros
                num++;
            }
            steps++;
        }

        return steps;
    }
}
