class Solution {
    public int countMaxOrSubsets(int[] nums) {
        int maxOr = 0;
        for (int num : nums) {
            maxOr |= num;
        }
        return backtrack(nums, 0, 0, maxOr);
    }

    private int backtrack(int[] nums, int index, int currentOr, int maxOr) {
        // Pruning: once currentOr equals maxOr, all remaining elements
        // can either be included or excluded without changing the OR.
        if (currentOr == maxOr) {
            return 1 << (nums.length - index);
        }

        if (index == nums.length) {
            return 0;
        }

        // Include nums[index] + Exclude nums[index]
        int include = backtrack(nums, index + 1, currentOr | nums[index], maxOr);
        int exclude = backtrack(nums, index + 1, currentOr, maxOr);

        return include + exclude;
    }
}
