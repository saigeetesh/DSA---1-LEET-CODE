class Solution {
    public int kthGrammar(int n, int k) {
        if (n == 1) {
            return 0;
        }
        
        // Find the parent symbol in the previous row
        int parent = kthGrammar(n - 1, (k + 1) / 2);
        
        // If k is odd, it is the first child (same as parent)
        // If k is even, it is the second child (flipped from parent)
        if (k % 2 == 1) {
            return parent;
        } else {
            return 1 - parent;
        }
    }
}
