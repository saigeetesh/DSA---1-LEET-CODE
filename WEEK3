class Solution {
    public int findTheWinner(int n, int k) {
        int winner = 0; // 0-indexed base case for 1 person
        
        for (int i = 2; i <= n; i++) {
            winner = (winner + k) % i;
        }
        
        // Convert back to 1-indexed result
        return winner + 1;
    }
}
