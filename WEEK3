class Solution {
    public boolean parseBoolExpr(String expression) {
        Deque<Character> stack = new ArrayDeque<>();

        for (char ch : expression.toCharArray()) {
            if (ch == ',' || ch == '(') {
                continue;
            }

            if (ch != ')') {
                stack.push(ch);
            } else {
                boolean hasTrue = false;
                boolean hasFalse = false;

                // Pop all boolean values inside the current parentheses
                while (stack.peek() == 't' || stack.peek() == 'f') {
                    char val = stack.pop();
                    if (val == 't') hasTrue = true;
                    if (val == 'f') hasFalse = true;
                }

                // Pop the operator ('!', '&', or '|')
                char op = stack.pop();
                char result;

                if (op == '!') {
                    result = hasTrue ? 'f' : 't';
                } else if (op == '&') {
                    result = hasFalse ? 'f' : 't';
                } else { // op == '|'
                    result = hasTrue ? 't' : 'f';
                }

                stack.push(result);
            }
        }

        return stack.pop() == 't';
    }
}
