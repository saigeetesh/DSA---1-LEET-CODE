class Solution {
    public boolean canReach(int[] arr, int start) {
        if (start < 0 || start >= arr.length || arr[start] < 0) {
            return false;
        }
        
        if (arr[start] == 0) {
            return true;
        }
        
        int jump = arr[start];
        // Mark as visited by negating the value
        arr[start] = -arr[start];
        
        return canReach(arr, start + jump) || canReach(arr, start - jump);
    }
}
