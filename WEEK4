code:
class Solution {
    private boolean[][] rows = new boolean[9][10];
    private boolean[][] cols = new boolean[9][10];
    private boolean[][] boxes = new boolean[9][10];

    public void solveSudoku(char[][] board) {
        // Pre-populate the constraint arrays with initial board digits
        for (int r = 0; r < 9; r++) {
            for (int c = 0; c < 9; c++) {
                if (board[r][c] != '.') {
                    int num = board[r][c] - '0';
                    int boxIdx = (r / 3) * 3 + (c / 3);
                    rows[r][num] = cols[c][num] = boxes[boxIdx][num] = true;
                }
            }
        }
        backtrack(board, 0, 0);
    }

    private boolean backtrack(char[][] board, int r, int c) {
        // Move to the next row once we reach the end of the current row
        if (c == 9) {
            return backtrack(board, r + 1, 0);
        }
        // Base case: all rows 0..8 are filled
        if (r == 9) {
            return true;
        }
        // Skip pre-filled cells
        if (board[r][c] != '.') {
            return backtrack(board, r, c + 1);
        }

        int boxIdx = (r / 3) * 3 + (c / 3);

        for (int num = 1; num <= 9; num++) {
            // Check if 'num' is valid in the current row, column, and 3x3 box
            if (!rows[r][num] && !cols[c][num] && !boxes[boxIdx][num]) {
                // Place digit
                board[r][c] = (char) (num + '0');
                rows[r][num] = cols[c][num] = boxes[boxIdx][num] = true;

                // Recurse to the next cell
                if (backtrack(board, r, c + 1)) {
                    return true;
                }

                // Backtrack: undo placement
                board[r][c] = '.';
                rows[r][num] = cols[c][num] = boxes[boxIdx][num] = false;
            }
        }

        return false;
    }
}
