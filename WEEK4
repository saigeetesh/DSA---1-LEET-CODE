import java.util.ArrayList;
import java.util.List;

class Solution {
    public List<String> generateParenthesis(int n) {
        List<String> results = new ArrayList<>();
        backtrack(results, new StringBuilder(), 0, 0, n);
        return results;
    }

    private void backtrack(List<String> results, StringBuilder current, int open, int close, int max) {
        // Base case: string length reaches 2 * n
        if (current.length() == max * 2) {
            results.add(current.toString());
            return;
        }

        // Add '(' if we haven't reached the limit of 'n' opening brackets
        if (open < max) {
            current.append('(');
            backtrack(results, current, open + 1, close, max);
            current.deleteCharAt(current.length() - 1); // backtrack
        }

        // Add ')' only if there is an unmatched '(' available
        if (close < open) {
            current.append(')');
            backtrack(results, current, open, close + 1, max);
            current.deleteCharAt(current.length() - 1); // backtrack
        }
    }
}
