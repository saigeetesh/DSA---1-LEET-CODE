import java.util.Arrays;

class Solution {
    public int uniquePaths(int m, int n) {
        // 1D array representing the number of ways to reach each column in the current row
        int[] dp = new int[n];
        
        // Base case: There is only 1 way to reach any cell in the first row (keep moving right)
        Arrays.fill(dp, 1);

        // Update the DP array row by row starting from row 1
        for (int r = 1; r < m; r++) {
            for (int c = 1; c < n; c++) {
                // dp[c] (before update) is the cell directly above
                // dp[c - 1] (already updated) is the cell to the left
                dp[c] += dp[c - 1];
            }
        }

        return dp[n - 1];
    }
}
