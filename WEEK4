import java.util.Arrays;

class Solution {
    public int coinChange(int[] coins, int amount) {
        // Initialize DP array with a value larger than any possible coin count (amount + 1)
        int max = amount + 1;
        int[] dp = new int[amount + 1];
        Arrays.fill(dp, max);
        
        // Base case: 0 coins are needed to make amount 0
        dp[0] = 0;

        // Compute the minimum coins needed for each sub-amount from 1 to amount
        for (int i = 1; i <= amount; i++) {
            for (int coin : coins) {
                if (coin <= i) {
                    dp[i] = Math.min(dp[i], dp[i - coin] + 1);
                }
            }
        }

        // If dp[amount] wasn't updated from 'max', the amount cannot be formed
        return dp[amount] > amount ? -1 : dp[amount];
    }
}
