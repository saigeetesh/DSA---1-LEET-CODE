import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

class Solution {
    public List<List<Integer>> permuteUnique(int[] nums) {
        List<List<Integer>> results = new ArrayList<>();
        // Sort so identical numbers are adjacent
        Arrays.sort(nums);
        boolean[] used = new boolean[nums.length];
        backtrack(nums, used, new ArrayList<>(), results);
        return results;
    }

    private void backtrack(int[] nums, boolean[] used, List<Integer> current, List<List<Integer>> results) {
        if (current.size() == nums.length) {
            results.add(new ArrayList<>(current));
            return;
        }

        for (int i = 0; i < nums.length; i++) {
            // Skip elements already in the current permutation
            if (used[i]) continue;

            // Skip duplicate elements at the same recursion depth:
            // If nums[i] equals nums[i - 1] and nums[i - 1] wasn't used in this branch,
            // picking nums[i] would generate an identical permutation branch.
            if (i > 0 && nums[i] == nums[i - 1] && !used[i - 1]) continue;

            used[i] = true;
            current.add(nums[i]);

            backtrack(nums, used, current, results);

            // Backtrack
            used[i] = false;
            current.remove(current.size() - 1);
        }
    }
}
