class Solution {
    public int[][] matrixBlockSum(int[][] mat, int k) {
        int m = mat.length;
        int n = mat[0].length;
        
        // 1-indexed 2D prefix sum table to avoid boundary checks
        int[][] prefix = new int[m + 1][n + 1];
        
        for (int r = 0; r < m; r++) {
            for (int c = 0; c < n; c++) {
                prefix[r + 1][c + 1] = mat[r][c] 
                                     + prefix[r][c + 1] 
                                     + prefix[r + 1][c] 
                                     - prefix[r][c];
            }
        }
        
        int[][] answer = new int[m][n];
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                // Clamp the window boundaries to stay within [0, m - 1] and [0, n - 1]
                int r1 = Math.max(0, i - k);
                int c1 = Math.max(0, j - k);
                int r2 = Math.min(m - 1, i + k);
                int c2 = Math.min(n - 1, j + k);
                
                // Query the submatrix sum in O(1) using 1-based prefix indices
                answer[i][j] = prefix[r2 + 1][c2 + 1] 
                             - prefix[r1][c2 + 1] 
                             - prefix[r2 + 1][c1] 
                             + prefix[r1][c1];
            }
        }
        
        return answer;
    }
}
