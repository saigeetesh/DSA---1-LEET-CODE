import java.util.HashMap;
import java.util.Map;

class Solution {
    public int subarraySum(int[] nums, int k) {
        // Maps a prefix sum to the number of times it has occurred so far
        Map<Integer, Integer> prefixCount = new HashMap<>();
        
        // Base case: a prefix sum of 0 occurs once before processing any elements
        // (handles subarrays starting from index 0 that sum directly to k)
        prefixCount.put(0, 1);
        
        int count = 0;
        int currentSum = 0;
        
        for (int num : nums) {
            currentSum += num;
            
            // If (currentSum - k) was seen before, every occurrence marks the start
            // of a contiguous subarray ending here whose elements sum to k.
            count += prefixCount.getOrDefault(currentSum - k, 0);
            
            // Record the current prefix sum frequency
            prefixCount.put(currentSum, prefixCount.getOrDefault(currentSum, 0) + 1);
        }
        
        return count;
    }
}
