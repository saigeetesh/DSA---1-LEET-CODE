class Solution {
    public boolean carPooling(int[][] trips, int capacity) {
        // Constraints specify: 0 <= from_i < to_i <= 1000
        int[] passengerChanges = new int[1001];

        // Record net passenger change at each pickup and drop-off kilometer
        for (int[] trip : trips) {
            int passengers = trip[0];
            int from = trip[1];
            int to = trip[2];

            passengerChanges[from] += passengers; // Pick up
            passengerChanges[to] -= passengers;   // Drop off
        }

        // Sweep east along the route and verify capacity at every kilometer
        int currentPassengers = 0;
        for (int change : passengerChanges) {
            currentPassengers += change;
            if (currentPassengers > capacity) {
                return false;
            }
        }

        return true;
    }
}
