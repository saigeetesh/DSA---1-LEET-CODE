class NumMatrix {
    private int[][] dp;

    public NumMatrix(int[][] matrix) {
        if (matrix == null || matrix.length == 0 || matrix[0].length == 0) {
            return;
        }
        int rows = matrix.length;
        int cols = matrix[0].length;
        
        // Use (rows + 1) x (cols + 1) with 0-padded top row and left column
        // to eliminate boundary checks during queries.
        dp = new int[rows + 1][cols + 1];
        
        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < cols; c++) {
                dp[r + 1][c + 1] = matrix[r][c] 
                                 + dp[r][c + 1]   // sum above
                                 + dp[r + 1][c]   // sum to the left
                                 - dp[r][c];      // subtract overlapping top-left area
            }
        }
    }
    
    public int sumRegion(int row1, int col1, int row2, int col2) {
        return dp[row2 + 1][col2 + 1] 
             - dp[row1][col2 + 1]     // remove region above
             - dp[row2 + 1][col1]     // remove region to the left
             + dp[row1][col1];        // add back top-left overlap subtracted twice
    }
}

