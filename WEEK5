class Solution {
    public int subarraysDivByK(int[] nums, int k) {
        // Stores the frequency of each remainder (0 to k - 1)
        int[] remainderCount = new int[k];
        
        // Base case: a prefix sum of 0 has remainder 0 once before processing elements
        remainderCount[0] = 1;
        
        int count = 0;
        int prefixSum = 0;
        
        for (int num : nums) {
            prefixSum += num;
            
            // Normalize negative remainders in Java so remainder is always in [0, k - 1]
            int remainder = ((prefixSum % k) + k) % k;
            
            // Every prior prefix with the same remainder forms a valid subarray ending here
            count += remainderCount[remainder];
            
            // Record the occurrence of this remainder
            remainderCount[remainder]++;
        }
        
        return count;
    }
}
