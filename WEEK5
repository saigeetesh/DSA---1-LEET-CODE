import java.util.TreeSet;

class Solution {
    public int maxSumSubmatrix(int[][] matrix, int k) {
        int rows = matrix.length;
        int cols = matrix[0].length;
        int maxSum = Integer.MIN_VALUE;

        // Iterate over all pairs of top and bottom rows (r1..r2)
        for (int r1 = 0; r1 < rows; r1++) {
            int[] colSums = new int[cols];

            for (int r2 = r1; r2 < rows; r2++) {
                // Accumulate column sums between row r1 and row r2
                for (int c = 0; c < cols; c++) {
                    colSums[c] += matrix[r2][c];
                }

                // Optimization: Kadane's algorithm finds the max 1D subarray sum in O(cols).
                // If even the unrestricted max subarray sum is <= k, we don't need the TreeSet.
                int kadaneMax = getMaxSubarrayKadane(colSums);
                if (kadaneMax <= k) {
                    maxSum = Math.max(maxSum, kadaneMax);
                    if (maxSum == k) return k;
                    continue;
                }

                // Otherwise, use Prefix Sum + TreeSet to find the largest subarray sum <= k
                TreeSet<Integer> prefixSums = new TreeSet<>();
                prefixSums.add(0);
                int currPrefix = 0;

                for (int sum : colSums) {
                    currPrefix += sum;
                    // Find the smallest previous prefix sum >= (currPrefix - k)
                    // so that (currPrefix - prevPrefix) <= k is maximized
                    Integer target = prefixSums.ceiling(currPrefix - k);
                    if (target != null) {
                        maxSum = Math.max(maxSum, currPrefix - target);
                        if (maxSum == k) return k;
                    }
                    prefixSums.add(currPrefix);
                }
            }
        }

        return maxSum;
    }

    private int getMaxSubarrayKadane(int[] nums) {
        int maxEndingHere = nums[0];
        int maxSoFar = nums[0];
        for (int i = 1; i < nums.length; i++) {
            maxEndingHere = Math.max(nums[i], maxEndingHere + nums[i]);
            maxSoFar = Math.max(maxSoFar, maxEndingHere);
        }
        return maxSoFar;
    }
}

