import java.util.HashMap;
import java.util.Map;

class Solution {
    public int findMaxLength(int[] nums) {
        // Maps a running sum to the FIRST index where it was encountered
        Map<Integer, Integer> firstSeen = new HashMap<>();
        
        // Base case: a sum of 0 exists before index 0 (at index -1)
        firstSeen.put(0, -1);
        
        int maxLen = 0;
        int sum = 0;
        
        for (int i = 0; i < nums.length; i++) {
            // Treat 0 as -1 and 1 as +1
            sum += (nums[i] == 1) ? 1 : -1;
            
            if (firstSeen.containsKey(sum)) {
                // If the same running sum occurred earlier, the subarray between
                // firstSeen.get(sum) + 1 and i has an equal number of 0s and 1s.
                maxLen = Math.max(maxLen, i - firstSeen.get(sum));
            } else {
                // Only store the earliest index to maximize subarray length
                firstSeen.put(sum, i);
            }
        }
        
        return maxLen;
    }
}
