class Solution {
    public int[] corpFlightBookings(int[][] bookings, int n) {
        int[] answer = new int[n];

        // Step 1: Mark the start and end boundaries of each booking in O(1)
        for (int[] booking : bookings) {
            int first = booking[0] - 1; // Convert 1-indexed flight to 0-indexed
            int last = booking[1] - 1;
            int seats = booking[2];

            answer[first] += seats;
            if (last + 1 < n) {
                answer[last + 1] -= seats;
            }
        }

        // Step 2: Compute the running prefix sum to get total seats per flight
        for (int i = 1; i < n; i++) {
            answer[i] += answer[i - 1];
        }

        return answer;
    }
}
