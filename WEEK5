class Solution {
    public String shiftingLetters(String s, int[][] shifts) {
        int n = s.length();
        // Difference array of size n + 1 to safely mark end + 1 boundaries
        int[] diff = new int[n + 1];

        // Step 1: Record each range shift in O(1)
        for (int[] shift : shifts) {
            int start = shift[0];
            int end = shift[1];
            int delta = (shift[2] == 1) ? 1 : -1;

            diff[start] += delta;
            diff[end + 1] -= delta;
        }

        // Step 2: Compute running prefix sum and apply wrapped character shifts
        char[] chars = s.toCharArray();
        int netShift = 0;

        for (int i = 0; i < n; i++) {
            netShift += diff[i];
            
            // Normalize netShift into [0, 25] to handle large or negative shifts cleanly
            int effectiveShift = ((netShift % 26) + 26) % 26;
            chars[i] = (char) ('a' + (chars[i] - 'a' + effectiveShift) % 26);
        }

        return new String(chars);
    }
}
