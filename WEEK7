class Solution {
    public int lengthOfLongestSubstring(String s) {
        // Array to store the last seen index + 1 of each ASCII character
        int[] lastSeen = new int[128];
        int maxLength = 0;
        int left = 0;

        for (int right = 0; right < s.length(); right++) {
            char currentChar = s.charAt(right);
            
            // If the character was seen inside the current window, jump 'left' past it
            left = Math.max(left, lastSeen[currentChar]);
            
            // Calculate the current window size and update maxLength
            maxLength = Math.max(maxLength, right - left + 1);
            
            // Record the index after the current character (right + 1)
            lastSeen[currentChar] = right + 1;
        }

        return maxLength;
    }
}
