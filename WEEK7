class Solution {
    public int characterReplacement(String s, int k) {
        int[] count = new int[26];
        int maxCount = 0; // Frequency of the single most common character in the window
        int maxLength = 0;
        int left = 0;

        for (int right = 0; right < s.length(); right++) {
            // 1. Add the new character on the right and update the highest frequency seen
            int currentCharIndex = s.charAt(right) - 'A';
            count[currentCharIndex]++;
            maxCount = Math.max(maxCount, count[currentCharIndex]);

            // 2. Check if replacements needed exceed k: (windowLength - maxCount > k)
            // If invalid, shrink the window from the left by 1
            if ((right - left + 1) - maxCount > k) {
                count[s.charAt(left) - 'A']--;
                left++;
            }

            // 3. Record the maximum valid window size
            maxLength = Math.max(maxLength, right - left + 1);
        }

        return maxLength;
    }
}
6. LC 5 longest palindromic substring
code:
class Solution {
    public String longestPalindrome(String s) {
        if (s == null || s.length() < 1) {
            return "";
        }

        int start = 0;
        int end = 0;

        for (int i = 0; i < s.length(); i++) {
            // 1. Expand around a single character (odd-length palindromes like "bab")
            int len1 = expandAroundCenter(s, i, i);
            
            // 2. Expand around two adjacent characters (even-length palindromes like "bb")
            int len2 = expandAroundCenter(s, i, i + 1);
            
            int maxLen = Math.max(len1, len2);

            // 3. Update the start and end indices if a longer palindrome is found
            if (maxLen > end - start + 1) {
                start = i - (maxLen - 1) / 2;
                end = i + maxLen / 2;
            }
        }

        return s.substring(start, end + 1);
    }

    private int expandAroundCenter(String s, int left, int right) {
        // Expand outward while pointers stay in bounds and characters match
        while (left >= 0 && right < s.length() && s.charAt(left) == s.charAt(right)) {
            left--;
            right++;
        }
        // Return the length of the valid palindrome found
        return right - left - 1;
    }
}
