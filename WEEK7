class Solution {
    public String minWindow(String s, String t) {
        if (s.length() < t.length()) {
            return "";
        }

        // Frequency map of characters required from string 't'
        int[] targetCount = new int[128];
        for (char c : t.toCharArray()) {
            targetCount[c]++;
        }

        int required = t.length(); // Total characters still needed to form a valid window
        int left = 0;
        int minLength = Integer.MAX_VALUE;
        int minStart = 0;

        for (int right = 0; right < s.length(); right++) {
            char rightChar = s.charAt(right);

            // If this character is still needed for 't', decrement the required counter
            if (targetCount[rightChar] > 0) {
                required--;
            }
            // Decrement count in map (characters not in 't' will go negative)
            targetCount[rightChar]--;

            // Once all characters from 't' are covered, shrink from the left to minimize
            while (required == 0) {
                if (right - left + 1 < minLength) {
                    minLength = right - left + 1;
                    minStart = left;
                }

                char leftChar = s.charAt(left);
                targetCount[leftChar]++;

                // If removing leftChar causes a deficit of a required character, window becomes invalid
                if (targetCount[leftChar] > 0) {
                    required++;
                }
                left++;
            }
        }

        return minLength == Integer.MAX_VALUE ? "" : s.substring(minStart, minStart + minLength);
    }
}
