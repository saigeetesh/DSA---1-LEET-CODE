import java.util.Arrays;

class Solution {
    public boolean checkInclusion(String s1, String s2) {
        int len1 = s1.length();
        int len2 = s2.length();

        // Edge case: s2 cannot contain a permutation of s1 if s1 is longer
        if (len1 > len2) {
            return false;
        }

        int[] s1Count = new int[26];
        int[] windowCount = new int[26];

        // 1. Populate frequency counts for s1 and the initial window of s2
        for (int i = 0; i < len1; i++) {
            s1Count[s1.charAt(i) - 'a']++;
            windowCount[s2.charAt(i) - 'a']++;
        }

        // Check if the initial window matches
        if (Arrays.equals(s1Count, windowCount)) {
            return true;
        }

        // 2. Slide the fixed-size window across the rest of s2
        for (int i = len1; i < len2; i++) {
            // Add the new character entering the right side of the window
            windowCount[s2.charAt(i) - 'a']++;
            
            // Remove the character leaving the left side of the window
            windowCount[s2.charAt(i - len1) - 'a']--;

            // If frequency arrays match, a permutation of s1 exists in s2
            if (Arrays.equals(s1Count, windowCount)) {
                return true;
            }
        }

        return false;
    }
}
