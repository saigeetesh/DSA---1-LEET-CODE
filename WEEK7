class Solution {
    public boolean isAnagram(String s, String t) {
        // Anagrams must have the exact same length
        if (s.length() != t.length()) {
            return false;
        }

        int[] counts = new int[26];

        // Increment count for characters in 's' and decrement for characters in 't'
        for (int i = 0; i < s.length(); i++) {
            counts[s.charAt(i) - 'a']++;
            counts[t.charAt(i) - 'a']--;
        }

        // If every character count balanced back to 0, they are anagrams
        for (int count : counts) {
            if (count != 0) {
                return false;
            }
        }

        return true;
    }
}
