import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

class Solution {
    public List<Integer> findAnagrams(String s, String p) {
        List<Integer> result = new ArrayList<>();
        int sLen = s.length();
        int pLen = p.length();

        // Edge case: p cannot be an anagram of any substring in s if it is longer
        if (pLen > sLen) {
            return result;
        }

        int[] pCount = new int[26];
        int[] windowCount = new int[26];

        // 1. Populate frequency counts for 'p' and the initial window in 's'
        for (int i = 0; i < pLen; i++) {
            pCount[p.charAt(i) - 'a']++;
            windowCount[s.charAt(i) - 'a']++;
        }

        // Check if the initial window at index 0 is an anagram
        if (Arrays.equals(pCount, windowCount)) {
            result.add(0);
        }

        // 2. Slide the window across the rest of 's'
        for (int i = pLen; i < sLen; i++) {
            // Add the new character entering the right side of the window
            windowCount[s.charAt(i) - 'a']++;
            
            // Remove the character leaving the left side of the window
            windowCount[s.charAt(i - pLen) - 'a']--;

            // If frequency arrays match, record the starting index of the current window
            if (Arrays.equals(pCount, windowCount)) {
                result.add(i - pLen + 1);
            }
        }

        return result;
    }
}
