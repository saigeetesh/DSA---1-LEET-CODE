class Solution {
    public void moveZeroes(int[] nums) {
        int writePos = 0;

        // Step 1: Move all non-zero elements forward in their original order
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != 0) {
                nums[writePos++] = nums[i];
            }
        }

        // Step 2: Fill the remaining trailing positions with 0
        while (writePos < nums.length) {
            nums[writePos++] = 0;
        }
    }
}
