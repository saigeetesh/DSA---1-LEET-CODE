import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

class Solution {
    public List<List<Integer>> fourSum(int[] nums, int target) {
        List<List<Integer>> result = new ArrayList<>();
        int n = nums.length;
        if (n < 4) {
            return result;
        }

        // Step 1: Sort the array to enable two-pointer traversal and duplicate skipping
        Arrays.sort(nums);

        for (int i = 0; i < n - 3; i++) {
            // Skip duplicate values for the 1st element
            if (i > 0 && nums[i] == nums[i - 1]) {
                continue;
            }
            // Pruning: smallest possible sum with nums[i] is already > target
            if ((long) nums[i] + nums[i + 1] + nums[i + 2] + nums[i + 3] > target) {
                break;
            }
            // Pruning: largest possible sum with nums[i] is still < target
            if ((long) nums[i] + nums[n - 3] + nums[n - 2] + nums[n - 1] < target) {
                continue;
            }

            for (int j = i + 1; j < n - 2; j++) {
                // Skip duplicate values for the 2nd element
                if (j > i + 1 && nums[j] == nums[j - 1]) {
                    continue;
                }
                // Pruning for the 2nd element
                if ((long) nums[i] + nums[j] + nums[j + 1] + nums[j + 2] > target) {
                    break;
                }
                if ((long) nums[i] + nums[j] + nums[n - 2] + nums[n - 1] < target) {
                    continue;
                }

                int left = j + 1;
                int right = n - 1;

                while (left < right) {
                    // Cast to long to avoid integer overflow (e.g., 4 * 10^9)
                    long sum = (long) nums[i] + nums[j] + nums[left] + nums[right];

                    if (sum == target) {
                        result.add(Arrays.asList(nums[i], nums[j], nums[left], nums[right]));

                        // Skip duplicate values for the 3rd and 4th elements
                        while (left < right && nums[left] == nums[left + 1]) {
                            left++;
                        }
                        while (left < right && nums[right] == nums[right - 1]) {
                            right--;
                        }

                        left++;
                        right--;
                    } else if (sum < target) {
                        left++;
                    } else {
                        right--;
                    }
                }
            }
        }

        return result;
    }
}
