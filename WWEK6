import java.util.Arrays;

class Solution {
    public int threeSumClosest(int[] nums, int target) {
        // Step 1: Sort the array to allow two-pointer adjustments
        Arrays.sort(nums);
        
        // Initialize closestSum with the first valid triplet
        int closestSum = nums[0] + nums[1] + nums[2];
        
        for (int i = 0; i < nums.length - 2; i++) {
            // Optional optimization: skip duplicate first elements
            if (i > 0 && nums[i] == nums[i - 1]) {
                continue;
            }
            
            int left = i + 1;
            int right = nums.length - 1;
            
            while (left < right) {
                int currentSum = nums[i] + nums[left] + nums[right];
                
                // Update closestSum if currentSum is strictly closer to target
                if (Math.abs(target - currentSum) < Math.abs(target - closestSum)) {
                    closestSum = currentSum;
                }
                
                if (currentSum < target) {
                    left++;  // Need a larger sum to get closer to target
                } else if (currentSum > target) {
                    right--; // Need a smaller sum to get closer to target
                } else {
                    // Exact match found (distance is 0)
                    return currentSum;
                }
            }
        }
        
        return closestSum;
    }
}
