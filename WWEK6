class Solution {
    public int removeDuplicates(int[] nums) {
        if (nums.length == 0) {
            return 0;
        }

        // 'k' tracks the index where the next unique element should be placed
        int k = 1;

        for (int i = 1; i < nums.length; i++) {
            // Since the array is sorted, a new unique value appears whenever
            // the current element differs from the previous element.
            if (nums[i] != nums[i - 1]) {
                nums[k] = nums[i];
                k++;
            }
        }

        return k;
    }
}
