class Solution {
    public void sortColors(int[] nums) {
        int low = 0;                // Boundary for 0s (red)
        int mid = 0;                // Current element under inspection
        int high = nums.length - 1; // Boundary for 2s (blue)

        while (mid <= high) {
            if (nums[mid] == 0) {
                swap(nums, low, mid);
                low++;
                mid++;
            } else if (nums[mid] == 1) {
                mid++;
            } else { // nums[mid] == 2
                swap(nums, mid, high);
                high--;
                // Do not increment 'mid' here because the swapped element from 'high'
                // has not been inspected yet.
            }
        }
    }

    private void swap(int[] nums, int i, int j) {
        int temp = nums[i];
        nums[i] = nums[j];
        nums[j] = temp;
    }
}
